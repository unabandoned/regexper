{
  "name": "@unabandoned/regexper-render",
  "version": "1.0.1",
  "description": "Visualize a regular expression with a railroad diagram",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "es",
    "lib",
    "src"
  ],
  "scripts": {
    "clean": "rimraf es lib",
    "build:style": "node scripts/build-style.js",
    "build:esm": "tsc --module esnext --outDir ./es",
    "build:cjs": "tsc --module commonjs --outDir ./lib",
    "build": "npm run clean && npm run build:style && npm run build:cjs && npm run build:esm",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "regular expression",
    "regexp",
    "regexper",
    "visualize",
    "visualization",
    "railroad diagram",
    "railroad-diagrams",
    "regexp-validator"
  ],
  "license": "MIT",
  "author": {
    "name": "bubkoo",
    "email": "bubkoo.wy@gmail.com"
  },
  "dependencies": {
    "@unabandoned/regexper-parser": "1.0.1"
  },
  "peerDependencies": {
    "@svgdotjs/svg.js": "^3.1.2"
  },
  "devDependencies": {
    "@svgdotjs/svg.js": "3.2.8",
    "rimraf": "6.1.3",
    "svgdom": "0.1.29",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://github.com/unabandoned/regexper/tree/master/packages/render#readme",
  "bugs": {
    "url": "https://github.com/unabandoned/regexper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/regexper.git",
    "directory": "packages/render"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
