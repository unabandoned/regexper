{
  "exclude": [
    "**/node_modules",
    "**/es",
    "**/lib",
    "**/dist"
  ],
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "resolveJsonModule": true
  }
}
